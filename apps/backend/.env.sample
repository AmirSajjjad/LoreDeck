# PostgreSQL connection used by the async SQLAlchemy backend.
LOREDECK_DATABASE_HOST=localhost
LOREDECK_DATABASE_PORT=5432
LOREDECK_DATABASE_NAME=loredeck
LOREDECK_DATABASE_USER=loredeck
LOREDECK_DATABASE_PASSWORD=change-me
LOREDECK_DATABASE_DRIVER=postgresql+asyncpg
LOREDECK_DATABASE_ECHO=false

# system configuration
LOREDECK_DEBUG=false
LOREDECK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOREDECK_CORS_ALLOWED_METHODS=*
LOREDECK_CORS_ALLOWED_HEADERS=*

# Authentication. Generate a secure random value; never use this placeholder in production.
LOREDECK_JWT_SECRET=generate-a-secure-random-secret
LOREDECK_JWT_ALGORITHM=HS256
LOREDECK_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
