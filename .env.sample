# Docker Compose project and image version.
COMPOSE_PROJECT_NAME=loredeck
IMAGE_TAG=latest

# Published service addresses. Set FRONTEND_ORIGIN to the exact browser origin.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
BACKEND_UPSTREAM=http://backend:8000

# PostgreSQL. Replace the password before deployment.
POSTGRES_DB=loredeck
POSTGRES_USER=loredeck
POSTGRES_PASSWORD=replace-with-a-secure-password

# Game API authentication. Generate a strong random secret before deployment.
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated CORS methods and headers. Origins come from FRONTEND_ORIGIN.
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
